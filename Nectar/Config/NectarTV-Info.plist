	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.beesroadhouse.nectar.tv</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>nectar</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
