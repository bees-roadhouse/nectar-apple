<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist: what the build settings can't say. -->
	<!-- nectar://item/{id} and nectar://play/{id}, what the Top Shelf's tiles open (#74). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.beesroadhouse.nectar.tv</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>nectar</string>
			</array>
		</dict>
	</array>
	<!-- The keychain group the app shares with its Top Shelf extension; the team prefix is filled in at build time. -->
	<key>NectarSharedKeychainGroup</key>
	<string>$(AppIdentifierPrefix)com.beesroadhouse.nectar.shared</string>
</dict>
</plist>
